{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=StudentExamDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "StudentExamSystem",
    "Audience": "StudentExamSystem"
  },
  "Services": {
    "NotificationService": "http://localhost:7071/"
  },
  "InternalHttp": {
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "RetryBaseDelayMilliseconds": 200
  },
  "AllowedHosts": "*"
